generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id           String   @id @default(cuid())
  ticket       String   @unique
  professional String
  service      String
  date         String
  time         String
  name         String
  phone        String
  email        String
  notes        String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
}
